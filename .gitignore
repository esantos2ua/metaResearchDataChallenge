# Data — raw pulls and large artifacts are not committed
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
*.csv.gz
*.parquet
*.jsonl
*.db
*.sqlite
# Community validation form exports hold names and emails; only de-identified outputs are committed
data/validation/community/raw/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
.ipynb_checkpoints/
.python-version

# R
.Rproj.user/
.Rhistory
.RData
.Renviron

# Node / dashboard
node_modules/
dist/
build/
.next/

# Secrets / config
.env
.env.local
*.key

# OS / editors
.DS_Store
~$*          # Word/Excel lock files
Thumbs.db
.vscode/
.idea/
.claude/

# Local notes
notes/*
!notes/ADJUDICATION-REPORT.md
!notes/TOPIC-VALIDATION-DECISIONS.md
!notes/COMMUNITY-VALIDATION-DECISIONS.md
!notes/figures/
!data/raw/SNAPSHOT.md
